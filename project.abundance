      "interpreterVersion": 1,
      "code": "// face.normalsFrom\nfunction run(basis: Assembly, points: Assembly) {\n  let selectedFaces = basis.getSelectedFaces().filter((f) => f != null);\n  console.log(selectedFaces.length)\n  if (!selectedFaces || selectedFaces.length == 0) {\n    // get faces directly\n    basis.onLeafs((leaf) => {\n      if (leaf.geometry instanceof replicad.Face) {\n        selectedFaces.push(leaf.geometry)\n      } else if (leaf.is3D()) {\n        selectedFaces.push(...leaf.geometry.faces)\n      }\n      return leaf;\n    })\n  }\n  console.log(selectedFaces.length)\n  let res = undefined;\n  const result = points.onLeafs((point) => {\n    if (point.isPoint()) {\n      const dists = selectedFaces.map((face) => {\n        return projectVertexOntoFace(face, point.geometry)\n      })\n      dists.sort((a, b) => a[0] - b[0])\n      console.log(`selected face index: ${selectedFaces.findIndex((f) => f.isSame(dists[0][2]))} at dist ${dists[0][0]}. uv: ${dists[0][1]}`)\n      point.geometry = replicad.makeVertex(dists[0][2].normalAt(point.geometry.asTuple()).normalize())\n    }\n    return point;\n  })\n  return result;\n\n}\n\nfunction projectVertexOntoFace(\n  face: replicad.Face,\n  vertex: replicad.Vertex,\n): [number, [number, number], replicad.Face] {\n  const asVec = new replicad.Vector(vertex.asTuple())\n  const uv = face.uvCoordinates(asVec)\n  const res = face.pointOnSurface(uv[0], uv[1]);\n  return [res.add(asVec.multiply(-1)).Length, uv, face]\n}",
      "compiledCode": "\"use strict\";\n// face.normalsFrom\nfunction run(basis, points) {\n    let selectedFaces = basis.getSelectedFaces().filter((f) => f != null);\n    console.log(selectedFaces.length);\n    if (!selectedFaces || selectedFaces.length == 0) {\n        // get faces directly\n        basis.onLeafs((leaf) => {\n            if (leaf.geometry instanceof replicad.Face) {\n                selectedFaces.push(leaf.geometry);\n            }\n            else if (leaf.is3D()) {\n                selectedFaces.push(...leaf.geometry.faces);\n            }\n            return leaf;\n        });\n    }\n    console.log(selectedFaces.length);\n    let res = undefined;\n    const result = points.onLeafs((point) => {\n        if (point.isPoint()) {\n            const dists = selectedFaces.map((face) => {\n                return projectVertexOntoFace(face, point.geometry);\n            });\n            dists.sort((a, b) => a[0] - b[0]);\n            console.log(`selected face index: ${selectedFaces.findIndex((f) => f.isSame(dists[0][2]))} at dist ${dists[0][0]}. uv: ${dists[0][1]}`);\n            point.geometry = replicad.makeVertex(dists[0][2].normalAt(point.geometry.asTuple()).normalize());\n        }\n        return point;\n    });\n    return result;\n}\nfunction projectVertexOntoFace(face, vertex) {\n    const asVec = new replicad.Vector(vertex.asTuple());\n    const uv = face.uvCoordinates(asVec);\n    const res = face.pointOnSurface(uv[0], uv[1]);\n    return [res.add(asVec.multiply(-1)).Length, uv, face];\n}\n"
